{
	// Type-CHECK pass for the build/dev tools (tools/*.mts). These run on Node
	// via native type-stripping (no emit), so this config only type-checks —
	// it never produces output. Kept separate from tsconfig.check.json because
	// the tools need @types/node (process/console/fs) and the DOM-free runtime
	// check must NOT (Piu's Text/Image globals collide with lib.dom).
	"compilerOptions": {
		"target": "es2025",
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"types": ["node"],
		"lib": ["es2025"],
		"skipLibCheck": true,
		// tools import each other WITH the .mts extension (node type-stripping
		// requires it in the specifier); safe here because this config is noEmit.
		"allowImportingTsExtensions": true
	},
	// The config-page SCHEMAS live beside the example that owns them, but they
	// are tools-side modules: Node imports them, tools/config-page.mts types
	// them, and the device build excludes them (tsconfig.json). Checking them
	// HERE is what makes "typed schema" true — a `select` missing `options` or a
	// `slider` default outside its range fails `pnpm run typecheck`, not at
	// generation time.
	"include": ["tools/**/*.mts", "build.mts", "src/tsx/**/config-schema.mts"]
}

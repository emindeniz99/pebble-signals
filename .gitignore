.lock-waf_*
node_modules/
build/
src/embeddedjs/app/
src/embeddedjs/runtime-min/
# subsetted TTFs — generated per app by gen-manifest/fontsubset from the
# fonts.json beside the SOURCE ttf, which is the checked-in artifact
src/embeddedjs/fonts/
src/tsx/main.tsx
src/embeddedjs/manifest.json
coverage/
src/embeddedjs/runtime-build/
src/embeddedjs/runtime-types/
src/pkjs/index.js
# same story for the opt-in timeline helper: timeline.ts is the source,
# timeline.js is what `tsc -p tsconfig.pkjs.json` emits for `pebble build`
src/pkjs/timeline.js
examples/consumer/node_modules/
examples/consumer/package-lock.json
dist/
examples/consumer/build/
examples/consumer/src/embeddedjs/app/
examples/consumer/src/embeddedjs/runtime-min/
examples/consumer/src/embeddedjs/runtime-build/
examples/consumer/src/embeddedjs/runtime-types/
examples/consumer/src/embeddedjs/manifest.json
# npm debris — this project is pnpm-managed (pnpm-lock.yaml is the lockfile);
# the consumer smoke shells out to npm and can drop one of these at the root
package-lock.json
# Python bytecode from the tools/*.py drivers — never a source file.
# (This does NOT keep it out of the tarball: a path pulled in by package.json
# "files" cannot be excluded by .gitignore/.npmignore, so the pack side needs
# its own "!tools/__pycache__" entry — MEASURED with `npm pack --dry-run`.)
__pycache__/

# Universal junk/secret safety net — carried from the monorepo root ignore
# at graduation (field lesson 4): the root .gitignore that used to catch
# these is gone now that this IS the root.
.env
.env.*
.DS_Store

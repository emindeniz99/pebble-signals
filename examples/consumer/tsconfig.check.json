{
	// STRICT typecheck of the consumer's app code against the INSTALLED package
	// (node_modules/signal-piu — the tarball, not this repo's source tree).
	// Two import styles are both covered:
	//   * src/app.tsx      — `signal-piu/*` exports-map imports (editor/library
	//     style; per-file `@jsxImportSource signal-piu` pragma).
	//   * src/tsx/main.tsx — `runtime/*` device-specifier imports (what actually
	//     ships; resolved here via `paths` into the installed package's sources)
	//     plus real Piu host JSX (<Label>), typed by the package's vendored
	//     Moddable typings + its globals.d.ts JSX contract (both ship in the
	//     tarball), wired in through `files` below.
	"compilerOptions": {
		"target": "es2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"jsxImportSource": "runtime",
		"strict": true,
		"noEmit": true,
		"types": [],
		"lib": ["es2022"],
		"skipLibCheck": true,
		"paths": { "runtime/*": ["./node_modules/signal-piu/src/embeddedjs/runtime/*"] }
	},
	"include": ["src"],
	"files": [
		"node_modules/signal-piu/src/tsx/globals.d.ts",
		// one barrel = the WHOLE Moddable/Pebble typing surface
		"node_modules/signal-piu/types/moddable/all.d.ts"
	]
}

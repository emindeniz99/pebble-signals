# Supply-chain hardening: refuse dependency versions published less than
# 3 days ago (pnpm >=10.16 minimumReleaseAge, in minutes). Blunts the
# "malicious version published minutes ago" attack window.
# HONEST LIMIT: npm does NOT implement this key (it warns and ignores it) —
# the guard is live only under pnpm (see package.json "packageManager").
# When upgrading with npm, enforce it by hand: check `npm view <pkg> time`
# and refuse anything younger than 3 days (the 2026-07 upgrade round did).
minimum-release-age=4320

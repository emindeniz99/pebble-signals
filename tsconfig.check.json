{
	// Type-CHECK pass (npm run typecheck). Unlike tsconfig.json (noCheck,
	// transpile-only for the device build), this actually type-checks — it
	// enforces the component prop contracts in globals.d.ts. Scoped to the
	// type-guard test + the ambient decls so it stays fast and deterministic
	// and is not tripped by the deliberately-loose example .tsx files.
	"compilerOptions": {
		"target": "es2025",
		"module": "esnext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"jsxImportSource": "runtime",
		"strict": true,
		"noEmit": true,
		"types": [],
		// lib es2025 (no DOM): XS is ~ES2025, so this exposes the methods it
		// actually has. No DOM — Piu's global `Text`/`Image` otherwise collide
		// with lib.dom.d.ts, and XS is not a browser.
		"lib": ["es2025"],
		"skipLibCheck": true,
		// `runtime/*` imports resolve STRAIGHT to the runtime .ts sources (B6):
		// the source is the single typed truth — generics, prop contracts and
		// JSDoc live there, so there is no hand-maintained .d.ts to drift.
		// (Package consumers get generated .d.ts via `npm run build:types`.)
		// No baseUrl (deprecated in TS 6) — paths are tsconfig-relative.
		"paths": { "runtime/*": ["./src/embeddedjs/runtime/*"] }
	},
	// Vendor's package.json `types` field is broken (an array), so there is no
	// auto-resolution — the Piu/Pebble host-global .d.ts must be listed here by
	// path. skipLibCheck above suppresses their internal cross-module refs.
	"include": [
		"src/tsx/globals.d.ts",
		"tests/types.test-d.tsx",
		// the WHOLE vendored Moddable/Pebble surface — sensors, dictation,
		// storage, transitions, image/font decode — so every host API is typed
		// and importable. skipLibCheck suppresses their internal cross-refs.
		"types/moddable/**/*.d.ts"
	]
}

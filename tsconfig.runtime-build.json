{
	// EMIT pass for the TypeScript runtime: compiles src/embeddedjs/runtime/*.ts
	// -> plain .js into src/embeddedjs/runtime-build/ (gitignored), which build.mts
	// then minifies into runtime-min/ (what the manifest ships). Types ERASE —
	// the emitted .js is behavior-identical to the hand-written .js it replaces
	// (verified by an emit-diff in build.mts). target es2025 (XS is ~ES2025): the
	// runtime uses no post-es2022 syntax, so this emits byte-for-byte the same
	// .js as es2022 (measured — zero diff) — no downleveling, no injected
	// helpers, top-level class/function declarations preserved exactly (gotcha
	// 13 alias budget unchanged). es2025 is future headroom, not a behavior change.
	//
	// Cross-runtime imports (`from "runtime/signals"`) resolve via `paths`
	// straight to the sibling .ts SOURCE (B6) — real generic types, not ambient
	// shims. `paths` affects resolution only; the emitted import specifier stays
	// `runtime/signals` (what the mod manifest maps). Piu host classes come from
	// the vendored Moddable typings.
	"compilerOptions": {
		"target": "es2025",
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"lib": ["es2025"],
		"skipLibCheck": true,
		"types": [],
		"importHelpers": false,
		"removeComments": false,
		"newLine": "lf",
		// match the hand-written .js: fields are set in the constructor ([[Set]]),
		// not [[Define]]d — so tsc must NOT emit field initializers (which would
		// change semantics AND the emit-diff / gotcha-13 alias budget).
		"useDefineForClassFields": false,
		"paths": { "runtime/*": ["./src/embeddedjs/runtime/*"] },
		"outDir": "src/embeddedjs/runtime-build",
		"rootDir": "src/embeddedjs/runtime"
	},
	"include": ["src/embeddedjs/runtime/**/*.ts"],
	"files": [
		"types/moddable/piu/MC.d.ts",
		"types/moddable/pebble/global.d.ts",
		"types/moddable/pebble/piu.d.ts"
	]
}

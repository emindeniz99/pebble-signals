{
  "name": "signal-piu",
  "author": "MakeAwesomeHappen",
  "version": "1.0.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {
    "@moddable/pebbleproxy": "^0.1.8"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@types/node": "^24.13.2",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3"
  },
  "pebble": {
    "displayName": "signal-piu",
    "uuid": "8cfdaad8-76b2-462f-b5a1-72fbac90ab23",
    "projectType": "moddable",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery",
      "gabbro"
    ],
    "watchapp": {
      "watchface": false
    },
    "messageKeys": [
      "dummy"
    ],
    "resources": {
      "media": []
    }
  },
  "scripts": {
    "build:runtime": "tsc -p tsconfig.runtime-build.json",
    "build:types": "tsc -p tsconfig.runtime-build.json --declaration --emitDeclarationOnly --outDir src/embeddedjs/runtime-types",
    "test": "npm run build:runtime && node --test --experimental-vm-modules tests/*.test.mts",
    "test:xs": "npm run build:runtime && node tools/xstest.mts",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p tsconfig.runtime-build.json && tsc -p tsconfig.tools.json",
    "format": "biome format --write src/embeddedjs/runtime/ tools/ tests/ build.mts",
    "format:c": "clang-format -i src/c/*.c",
    "check:c": "clang-format --dry-run --Werror src/c/*.c",
    "lint": "biome lint src/embeddedjs/runtime/ tools/ tests/ build.mts",
    "check": "biome check src/embeddedjs/runtime/ tools/ tests/ build.mts",
    "docs": "npx -y -p typedoc@0.28 -p typedoc-plugin-markdown@4 typedoc",
    "coverage": "npm run build:runtime && node --test --experimental-vm-modules --experimental-test-coverage --test-coverage-include='src/embeddedjs/runtime-build/**' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 tests/*.test.mts",
    "build": "node build.mts",
    "test:mem": "python3 tools/memtest.py gabbro --idle 12 --presses 8",
    "test:limit": "python3 tools/memtest.py gabbro --ramp --max 40 --min 20"
  }
}

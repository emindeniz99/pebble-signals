{
	// DIST build for the npm tarball (prepack): compile build.mts + tools/ to
	// plain .mjs under dist/, because Node REFUSES to type-strip .mts inside
	// node_modules (ERR_UNSUPPORTED_NODE_MODULES_TYPE_STRIPPING) — a consumer
	// literally cannot run node_modules/pebble-signals/build.mts. In-repo dev keeps
	// running the .mts sources directly; consumers run dist/build.mjs.
	// rewriteRelativeImportExtensions rewrites the .mts import specifiers the
	// sources use (node type-stripping requires them) to .mjs in the emit.
	"compilerOptions": {
		"target": "es2025",
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"types": ["node"],
		"lib": ["es2025"],
		"skipLibCheck": true,
		"rewriteRelativeImportExtensions": true,
		"newLine": "lf",
		"outDir": "dist",
		"rootDir": "."
	},
	"include": ["build.mts", "tools/**/*.mts"],
	// timeline-push is a SOURCE-ONLY tool, deliberately. It imports the pin
	// contract from src/pkjs/timeline.ts — a .ts, because the PKJS half must emit
	// CommonJS — and this build would compile that dependency to
	// `dist/src/pkjs/timeline.js`: ESM syntax in a .js file inside a package with
	// no `"type"` field, which Node then treats as CommonJS. MEASURED: importing
	// the emitted dist/tools/timeline-push.mjs fails with "Named export
	// 'TIMELINE_API_ROOT' not found … is a CommonJS module". In-repo it runs
	// straight from source (`node tools/timeline-push.mts`), which is where a
	// server-side pusher belongs anyway; shipping it would need `src/pkjs/` in
	// package.json "files" AND a dual-emit story for the contract.
	"exclude": ["tools/timeline-push.mts"]
}
